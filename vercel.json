{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "lyrik-anime-manga.vercel.app"
        }
      ],
      "destination": "https://animedexfr.fr/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/anime",
      "destination": "/api/fiche?type=anime"
    },
    {
      "source": "/manga",
      "destination": "/api/fiche?type=manga"
    },
    {
      "source": "/anime/:id/similaires",
      "destination": "/api/fiche?type=anime&id=:id&sim=1"
    },
    {
      "source": "/anime/:id",
      "destination": "/api/fiche?type=anime&id=:id"
    },
    {
      "source": "/manga/:id/similaires",
      "destination": "/api/fiche?type=manga&id=:id&sim=1"
    },
    {
      "source": "/manga/:id",
      "destination": "/api/fiche?type=manga&id=:id"
    },
    {
      "source": "/img/:f",
      "destination": "/:f"
    }
  ],
  "headers": [
    {
      "source": "/([0-9a-f]{10}).jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/push?a=cron",
      "schedule": "0 7 * * *"
    }
  ]
}
